NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mentorhub?sslmode=require
DATABASE_SSL=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Mexico_City
CANCELLATION_MIN_HOURS=24
UPLOAD_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MentorHub <no-reply@example.com>
