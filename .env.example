# Backend (Render)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mentorhub?sslmode=require
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Mexico_City
UPLOAD_DIR=./uploads

# Email (optional in local development; configure in Render for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MentorHub <no-reply@example.com>

# Frontend (Vercel)
VITE_API_URL=http://localhost:4000/api
